{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "resolveJsonModule": true,

    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": true,

    "esModuleInterop": true,
    "skipLibCheck": true,

    "baseUrl": ".",

    "paths": {
      "@/*": ["src/*"]
    },

    "outDir": "./dist",
    "rootDir": "./src"
  },

  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}