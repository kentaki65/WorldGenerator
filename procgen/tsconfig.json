{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],

    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "resolveJsonModule": true,
    
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": true,

    "esModuleInterop": true,
    "skipLibCheck": true,

    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    
    "paths": {
      "@/*": ["src/*"]
    },

    "noEmit": true
  },

  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}